PGUSER=where2go
PGPASSWORD=<changeme>
PGDATABASE=where2go

# See other PG variables at https://www.postgresql.org/docs/current/libpq-envars.html

# Optional: Custom Valhalla endpoint for fetching road surface data (defaults to public OSM instance)
# VALHALLA_ENDPOINT=https://valhalla1.openstreetmap.de/trace_attributes

# Optional: Cloud Database keep-alive ping configuration (for Aiven / Neon / etc.)
# DB_PING_INTERVAL_MINUTES=60
# ENABLE_DB_PINGER=false

